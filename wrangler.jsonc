{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidal-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: lets clients identify themselves with a metadata URL (CIMD) safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Holds OAuth grants. Wrangler creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }]
  // Configuration is set as secrets, so it survives redeploys and stays out of the repo:
  //   npx wrangler secret put TIDAL_CLIENT_ID          your TIDAL app's client id
  //   npx wrangler secret put ALLOWED_TIDAL_USER_IDS   optional; your TIDAL user id, to lock the server to you
}
